# Copy this file to .env.local and fill in the values for your local environment.
# .env.local is gitignored and must never be committed.
#
# See docs/architecture/environment-strategy.md for the full local setup model.

# ---------------------------------------------------------------------------
# API base URL (torget-core)
# ---------------------------------------------------------------------------

# Client-side. Read by lib/api.ts on the browser. Must start with NEXT_PUBLIC_.
# Required in staging and production. Falls back to http://localhost:5000 in dev.
# Use http://localhost:5000 locally (torget-core disables HTTPS redirect in Development).
# If you point at https://localhost:7000, trust the dev cert and ensure CORS allows your origin.
NEXT_PUBLIC_TORGET_API_URL=http://localhost:5000

# Server-side alias. Read by lib/api.ts on the server (Next.js RSC / route handlers).
# Can be omitted locally if NEXT_PUBLIC_TORGET_API_URL is set.
TORGET_API_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# NextAuth / Auth.js
# ---------------------------------------------------------------------------

# Secret used to sign and encrypt session tokens.
# Generate a strong random value for staging and production:
#   openssl rand -base64 32
# A placeholder is sufficient for local development only.
NEXTAUTH_SECRET=change-me-in-production

# Canonical URL of this web app. Required in production to prevent open-redirect issues.
# Must match the exact origin (no trailing slash).
NEXTAUTH_URL=http://localhost:3000
